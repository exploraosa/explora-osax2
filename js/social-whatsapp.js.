
document.addEventListener("DOMContentLoaded", function () {
  const contacts = [
    { name: "Greivin", number: "50686196399" },
    { name: "Hannah", number: "5039430861" }
  ];

  function whatsappIcon() {
    return `
      <svg class="whatsapp-logo" viewBox="0 0 24 24"
           aria-hidden="true">
        <path fill="currentColor" d="M20.52 3.48A11.8 11.8 0 0 0 12.13 0C5.58 0 .25 5.33.25 11.88c0 2.09.55 4.14 1.61 5.94L.15 24l6.34-1.66a11.9 11.9 0 0 0 5.64 1.43h.01c6.55 0 11.88-5.33 11.88-11.88a11.8 11.8 0 0 0-3.5-8.41ZM12.14 21.75a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.76.99 1-3.67-.24-.38a9.82 9.82 0 1 1 8.39 4.65Zm5.39-7.36c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.46-.89-.79-1.48-1.77-1.65-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.71.62.72.23 1.37.2 1.88.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
      </svg>`;
  }

  function makeLink(contact, message) {
    const link = document.createElement("a");
    link.className = "explora-wa-option";
    link.href =
      "https://wa.me/" + contact.number +
      "?text=" + encodeURIComponent(message);
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.innerHTML = whatsappIcon() +
      "<span>WhatsApp " + contact.name + "</span>";
    return link;
  }

  function addBooking(container, message, buttonText) {
    if (!container || container.querySelector(".explora-wa-booking")) {
      return;
    }

    const wrapper = document.createElement("div");
    wrapper.className = "explora-wa-booking";

    const button = document.createElement("button");
    button.type = "button";
    button.className = "explora-wa-button";
    button.innerHTML = whatsappIcon() +
      "<span>" + buttonText + "</span>";

    const options = document.createElement("div");
    options.className = "explora-wa-options";
    options.hidden = true;

    contacts.forEach(function (contact) {
      options.appendChild(makeLink(contact, message));
    });

    button.addEventListener("click", function () {
      options.hidden = !options.hidden;
      button.setAttribute("aria-expanded", String(!options.hidden));
    });

    wrapper.appendChild(button);
    wrapper.appendChild(options);
    container.appendChild(wrapper);
  }

  // Add a booking button to every tour card.
  document.querySelectorAll(".tour-card").forEach(function (card) {
    const title = card.querySelector("h3");
    const content = card.querySelector(".tour-content, .tour-info");

    if (!title || !content) return;

    const tourName = title.textContent.trim();
    const message =
      "Hi! I'd like to book " + tourName +
      " with Explora Osa. Could you please tell me about availability and booking?";

    addBooking(content, message, "BOOK THIS TOUR");
  });

  // Add the WhatsApp button to the bottom contact section.
  document.querySelectorAll(".contact-section, .final-cta").forEach(
    function (section) {
      const content = section.querySelector(
        ".contact-container, .container"
      ) || section;

      addBooking(
        content,
        "Hi! I'd like to learn more about Explora Osa tours in Uvita, Costa Rica.",
        "WHATSAPP US"
      );
    }
  );
});


document.addEventListener("DOMContentLoaded", () => {
  const contacts = [
    { name: "Greivin", number: "50686196399" },
    { name: "Hannah", number: "5039430861" }
  ];

  function whatsappURL(number, message) {
    return `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
  }

  function createBooking(container, message, label = "WHATSAPP US") {
    if (!container || container.querySelector(".explora-booking")) return;

    const booking = document.createElement("div");
    booking.className = "explora-booking";

    const button = document.createElement("button");
    button.className = "explora-booking-button";
    button.type = "button";
    button.innerHTML = `
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.6 4.2 1.6 6L0 24l6.4-1.7a12 12 0 0 0 5.7 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.2-3.5-8.4ZM12.1 21.7a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 1 1 8.4 4.7Zm5.4-7.4c-.3-.1-1.8-.9-2.1-1-.3-.1-.5-.1-.7.2l-1 1.1c-.2.2-.4.2-.7.1a8.1 8.1 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5H7.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.8s1.2 3.2 1.4 3.4c.2.2 2.4 3.7 5.8 5.1.8.3 1.4.5 1.9.6.8.2 1.5.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z"/>
      </svg>
      <span>${label}</span>
    `;

    const options = document.createElement("div");
    options.className = "explora-booking-options";
    options.hidden = true;

    contacts.forEach(contact => {
      const link = document.createElement("a");
      link.className = "explora-booking-contact";
      link.href = whatsappURL(contact.number, message);
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = `WhatsApp ${contact.name}`;
      options.appendChild(link);
    });

    button.addEventListener("click", () => {
      options.hidden = !options.hidden;
    });

    booking.append(button, options);
    container.appendChild(booking);
  }

  // Booking buttons for tour cards
  document.querySelectorAll(".tour-card").forEach(card => {
    const title = card.querySelector("h3");
    const content = card.querySelector(
      ".tour-content, .tour-info, .tour-details"
    );

    if (!title || !content) return;

    const message =
      `Hi! I'd like to book the ${title.textContent.trim()} with Explora Osa. Please let me know the availability and details.`;

    createBooking(content, message, "BOOK THIS TOUR");
  });

  // General contact button at the bottom of the page
  document.querySelectorAll(".contact-section, .final-cta").forEach(section => {
    const content = section.querySelector(
      ".contact-container, .container"
    ) || section;

    const message =
      "Hi! I'd like to learn more about Explora Osa tours in Uvita, Costa Rica.";

    createBooking(content, message, "WHATSAPP US");
  });
});
